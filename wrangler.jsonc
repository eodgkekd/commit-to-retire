{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commit-to-retire",
  "compatibility_date": "2026-11-17",
  "main": "src/worker.ts",
  "kv_namespaces": [{ "binding": "SHARED_RESULTS" }],
  "ratelimits": [{ "name": "SHARE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
